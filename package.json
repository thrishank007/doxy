{
  "name": "doxy",
  "version": "0.1.0",
  "description": "Static API compatibility verifier — catches deprecated, removed, and future APIs at lint time",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "doxy": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "authority-data/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke:pack": "npm run build && node scripts/smoke-packed-cli.mjs"
  },
  "keywords": [
    "static-analysis",
    "api-compatibility",
    "deprecated",
    "lint",
    "react",
    "nextjs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@swc/core": "^1.10.0",
    "picomatch": "^4.0.4",
    "semver": "^7.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.5.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
